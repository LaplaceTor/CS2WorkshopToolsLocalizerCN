  "Cannot find RenderMesh node named [ empty name ].": "无法找到名为 [空名称] 的 RenderMesh 节点. ",
  "Cannot find RenderMesh node named '%s'.": "找不到名为'%s'的 RenderMesh 节点. ",
  "Simple": "简单",
