  "Extract failed": "提取失败",
  "Error analyzing anim '%1' for foot '%2': %3 (skipping anim)": "分析脚部'%2'的动画'%1'时出现错误: %3(已跳过该动画) (skipping anim)",
  "Analysis Error": "分析错误",
